# Allowed origin for CORS + Socket.IO (your frontend's URL).
# Use the dev server origin locally, or your deployed frontend in production.
CORS_ORIGIN=http://localhost:5173

# MongoDB connection string — local mongod or a MongoDB Atlas cluster.
# Note: docker compose overrides this to mongodb://mongo:27017/QikTalk (the
# separately-run Mongo container on the shared "mern" network). This value is
# used for non-Docker runs.
MONGO_URI=mongodb://127.0.0.1:27017/QikTalk

# Port the HTTP + Socket.IO server listens on.
PORT=4501

# Secret used to sign JWTs. Use a long, random value in production.
JWT_SECRET=change_me
